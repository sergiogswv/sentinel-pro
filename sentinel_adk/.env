# ─── URLs de Servicios ─────────────────────────────────
SENTINEL_CORE_URL=http://localhost:4001
CEREBRO_URL=http://localhost:4000

# ─── Proveedor de LLM ──────────────────────────────────
LLM_PROVIDER=gemini

# ─── Google Gemini ─────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Anthropic Claude ──────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Ollama (Local) ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── ADK Server ──────────────────────────────────────────
SENTINEL_ADK_PORT=4011

# ─── Memoria persistente ─────────────────────────────────
SENTINEL_DB_PATH=./sentinel_memory.db
